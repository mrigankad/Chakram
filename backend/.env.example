# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aidlc

# ── Ollama ─────────────────────────────────────────────────────────────────
# Local: http://localhost:11434 and any non-empty OLLAMA_API_KEY (e.g. ollama)
# Cloud: https://ollama.com + real key from https://ollama.com/settings/keys
# Provider: ollama (default) | openai | azure_openai | gemini. For azure_openai put the
# resource endpoint in OLLAMA_BASE_URL and the deployment name in OLLAMA_MODEL; for
# gemini only the key and model are read. Organizations can save their own in Settings.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=paste-your-real-ollama-cloud-key-here
OLLAMA_MODEL=kimi-k3:cloud
# Per-call LLM timeout in seconds, and the maximum LLM calls in flight at once.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=4
# Browsers one Test Execution run drives at the same time.
TEST_EXECUTION_CONCURRENCY=3

# ── GitHub / Vercel ────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=

# ── Jira / Slack ─────────────────────────────────────────────────
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_TOKEN=
SLACK_WEBHOOK_URL=

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=["http://localhost:8081","http://localhost:8080","http://localhost:5173"]

# ── WorkOS AuthKit ─────────────────────────────────────────────────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
WORKOS_REDIRECT_URI=http://localhost:8001/api/auth/callback
# Required in production: at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# Production only: who may sign up, and which orgs may use the integration
# credentials above (others must save their own in Settings -> Connectors).
SIGNUP_ALLOWED_DOMAINS=[]
ALLOW_OPEN_SIGNUP=false
PLATFORM_ORG_IDS=[]

# Accounts are provisioned by the operator. This account is created at startup if it
# does not exist; keep the password in the secret store, not in this file, in production.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
SEED_ORG_NAME=
SIGNUP_ENABLED=false
