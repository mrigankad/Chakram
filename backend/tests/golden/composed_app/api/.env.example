# PostgreSQL connection; leave unset to run with the in-memory store (development only).
DATABASE_URL=
# Port for `npm run dev` / `npm start`.
PORT=3001
# The org every account joins and the owner account created on first start.
DEFAULT_ORG_ID=org-1
DEFAULT_ORG_NAME=Default
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
NODE_ENV=development
